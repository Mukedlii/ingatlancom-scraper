{
  "name": "ingatlancom-scraper",
  "version": "4.0.0",
  "private": true,
  "description": "Magánhirdetések Telegram értesítője mobil API adapterrel",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env notifier/worker.js",
    "check": "node --env-file-if-exists=.env notifier/worker.js --once",
    "probe": "node --env-file-if-exists=.env notifier/probe.js",
    "test:telegram": "node --env-file-if-exists=.env notifier/test-message.js",
    "test": "node --test test/*.test.js",
    "test:live": "node --env-file-if-exists=.env integration/live.js"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
