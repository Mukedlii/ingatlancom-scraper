# Ellenőrzött, kijelentkezett mobil keresési API. Üres érték = ez az alapértelmezés.
INGATLAN_SEARCH_URL_TEMPLATE=https://mobile-gateway.ingatlan.com/v1/ads/search/{query}?page={page}
# Az apiLevel=115, buildNumber=273, channel=ANDROID fejlécek automatikusak.
# Az ellenőrzött kereséshez nem kellett Bearer vagy App Check token.
# Opcionális fejléc-felülírás; titkos hozzáférési adatot ne commitolj.
INGATLAN_API_HEADERS_JSON={}
NOTIFIER_SEARCHES_JSON='[{"id":"kecsked-haz","query":"elado+haz+kecsked","chatIds":["123456789"],"filters":{"city":"Kecskéd","maxPrice":60000000}}]'
MAX_SCAN_PAGES=20
POLL_INTERVAL_SECONDS=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STATE_NAMESPACE=ingatlan-notifier:v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_TEST_IMAGE_URL=
