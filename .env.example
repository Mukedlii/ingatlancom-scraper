# Nincs automatikusan kipróbált API-útvonal: a teljes URL-sablon még validálandó.
# Kötelező helyőrzők: {query}, {page}; csak https://mobile-gateway.ingatlan.com engedélyezett.
INGATLAN_SEARCH_URL_TEMPLATE=
# Csak jogszerűen rendelkezésre álló hozzáférési adatok. Ne commitold a valódi értékeket.
INGATLAN_API_HEADERS_JSON={}
NOTIFIER_SEARCHES_JSON='[{"id":"tatabanya-lakas","query":"elado+lakas+tatabanya","chatIds":["123456789"],"filters":{"city":"Tatabánya","maxPrice":60000000}}]'
MAX_SCAN_PAGES=20
POLL_INTERVAL_SECONDS=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STATE_NAMESPACE=ingatlan-notifier:v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
